{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=sqlite.db"
  },
  
  "JWT": {
    "Issuer": "WebAPI",
    "Audience": "WebApiUsers"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
